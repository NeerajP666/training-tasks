@model Learn1.Models.User
<div class="card-custom">
    <h2 class="text-center mb-4">Login</h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success text-center">@TempData["SuccessMessage"]</div>
    }

    @using (Html.BeginForm("Login", "Account", FormMethod.Post))
    {
        <div class="mb-3">
            @Html.LabelFor(m => m.Name)
            @Html.TextBoxFor(m => m.Name, new { @class = "form-control", placeholder = "Enter Username" })
        </div>
        <div class="mb-3">
            @Html.LabelFor(m => m.Password)
            @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Enter Password" })
        </div>
        <button type="submit" class="btn btn-custom w-100">Login</button>
    }

    <p class="mt-3 text-center">
        Don’t have an account? <a href="@Url.Action("Register", "Account")">Register here</a>
    </p>

    @if (ViewBag.Message != null)
    {
        <div class="text-danger text-center">@ViewBag.Message</div>
    }
</div>
