@model CRUD1.Models.User
@{
    ViewBag.Title = "Login";
}

<h2>Login</h2>
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true)

    <p>@Html.LabelFor(m => m.Email) @Html.TextBoxFor(m => m.Email)</p>
    <p>@Html.LabelFor(m => m.Password) @Html.PasswordFor(m => m.Password)</p>
    <button type="submit">Login</button>

    <p style="color:red;">@ViewBag.Error</p>
}
