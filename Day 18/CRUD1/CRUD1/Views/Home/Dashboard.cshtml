@model CRUD1.Models.User
@{
    ViewBag.Title = "Dashboard";
}
<h2>Welcome, @Session["UserName"]</h2>

<table border="1" cellpadding="5">
    <tr><th>ID</th><td>@Model.Id</td></tr>
    <tr><th>Name</th><td>@Model.Name</td></tr>
    <tr><th>Email</th><td>@Model.Email</td></tr>
    <tr><th>Age</th><td>@Model.Age</td></tr>
    <tr><th>City</th><td>@Model.City</td></tr>

    <tr><th>Gender</th><td>@Model.Gender</td></tr>
    <tr>
        <th>Agreed to Terms</th>
        <td>@(Model.IsAgree ? "Yes" : "No")</td>
    </tr>
    <tr><th>Profession</th><td>@Model.Profession</td></tr>
    <tr><th>About Me</th><td>@Model.AboutMe</td></tr>
</table>

<p>
    @Html.ActionLink("Edit Profile", "Edit", new { id = Model.Id }) |
    @Html.ActionLink("Logout", "Login")
    @Html.ActionLink("Delete Account", "Delete", new { id = Model.Id })
    @Html.ActionLink("All users", "UsersList", new { id = Model.Id })
</p>
